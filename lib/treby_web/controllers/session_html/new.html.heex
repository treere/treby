<div class="min-h-screen flex items-center justify-center bg-zinc-50 dark:bg-zinc-800 relative">
  <Layouts.auth_toolbar locale={@locale} />
  <div class="max-w-md w-full space-y-8">
    <div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-zinc-900 dark:text-zinc-100">
        {gettext("Sign in to your account")}
      </h2>
      <p class="mt-2 text-center text-sm text-zinc-500 dark:text-zinc-400">
        {gettext("Or")}
        <a href="/register" class="font-medium text-primary hover:text-primary/80">
          {gettext("create a new account")}
        </a>
      </p>
    </div>
    <.form for={%{}} action={~p"/session"} method="post" class="mt-8 space-y-6">
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <div class="rounded-md shadow-sm -space-y-px">
        <div>
          <label for="user_email" class="sr-only">{gettext("Email address")}</label>
          <input
            id="user_email"
            name="user[email]"
            type="email"
            required
            class="appearance-none rounded-none relative block w-full px-3 py-2 border border-zinc-200 dark:border-zinc-700 placeholder-base-content/50 text-zinc-900 dark:text-zinc-100 rounded-t-md focus:outline-none focus:ring-primary focus:border-primary focus:z-10 sm:text-sm"
            placeholder={gettext("Email address")}
          />
        </div>
        <div>
          <label for="user_password" class="sr-only">{gettext("Password")}</label>
          <input
            id="user_password"
            name="user[password]"
            type="password"
            required
            class="appearance-none rounded-none relative block w-full px-3 py-2 border border-zinc-200 dark:border-zinc-700 placeholder-base-content/50 text-zinc-900 dark:text-zinc-100 rounded-b-md focus:outline-none focus:ring-primary focus:border-primary focus:z-10 sm:text-sm"
            placeholder={gettext("Password")}
          />
        </div>
      </div>

      <div class="flex items-center justify-end">
        <div class="text-sm">
          <a href="/reset-password" class="font-medium text-primary hover:text-primary/80">
            {gettext("Forgot your password?")}
          </a>
        </div>
      </div>

      <div>
        <.button variant="primary" type="submit" class="w-full justify-center">
          {gettext("Sign in")}
        </.button>
      </div>
    </.form>
  </div>
</div>
