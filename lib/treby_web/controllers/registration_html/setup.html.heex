<div class="min-h-screen flex items-center justify-center bg-base-200 relative">
  <Layouts.auth_toolbar locale={@locale} />
  <div class="max-w-md w-full space-y-8">
    <div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-base-content">
        {gettext("Create your account")}
      </h2>
      <p class="mt-2 text-center text-sm text-base-content/70">
        {gettext("Email verified:")}
        <span class="font-medium text-base-content">{@verified_email}</span>
      </p>
    </div>

    <.form
      for={@form}
      id="registration-form"
      action={~p"/register"}
      method="post"
      class="mt-8 space-y-6"
    >
      <div class="space-y-4">
        <.input
          field={@form[:email]}
          type="email"
          label={gettext("Email address")}
          readonly
        />
        <.input
          field={@form[:company_name]}
          type="text"
          label={gettext("Company name")}
          placeholder={gettext("e.g. Acme Inc.")}
          required
        />
        <.input
          field={@form[:name]}
          type="text"
          label={gettext("Your name")}
          placeholder={gettext("e.g. Ada Lovelace")}
          required
        />
        <.input
          field={@form[:password]}
          type="password"
          label={gettext("Password")}
          placeholder={gettext("At least 6 characters")}
          required
          autocomplete="new-password"
        />
        <.input
          field={@form[:password_confirmation]}
          type="password"
          label={gettext("Confirm password")}
          placeholder={gettext("Repeat your password")}
          autocomplete="new-password"
        />
      </div>

      <div>
        <.input
          field={@form[:tos_accepted]}
          type="checkbox"
          label={gettext("I agree to the")}
        />
        <p class="ml-7 -mt-4 text-sm text-base-content">
          <a href="/terms" class="text-primary hover:text-primary/80">
            {gettext("Terms of Service")}
          </a>
          {gettext("and")}
          <a href="/privacy" class="text-primary hover:text-primary/80">
            {gettext("Privacy Policy")}
          </a>
        </p>
      </div>

      <div>
        <.button variant="primary" type="submit" class="w-full justify-center">
          {gettext("Create account")}
        </.button>
      </div>
    </.form>
  </div>
</div>
