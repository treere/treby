<div class="min-h-screen flex items-center justify-center bg-base-200 relative">
  <Layouts.auth_toolbar locale={@locale} />
  <div class="max-w-md w-full space-y-8">
    <div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-base-content">
        {gettext("Reset your password")}
      </h2>
      <p class="mt-2 text-center text-sm text-base-content/70">
        {gettext("Enter your email and we'll send you a reset link.")}
      </p>
    </div>
    <.form for={%{}} action={~p"/reset-password"} method="post" class="mt-8 space-y-6">
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <div class="rounded-md shadow-sm -space-y-px">
        <div>
          <label for="email" class="sr-only">{gettext("Email address")}</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="appearance-none rounded-none relative block w-full px-3 py-2 border border-base-300 placeholder-base-content/50 text-base-content rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm"
            placeholder={gettext("Email address")}
          />
        </div>
      </div>

      <div>
        <button
          type="submit"
          class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-base-200 focus:ring-blue-500"
        >
          {gettext("Send reset link")}
        </button>
      </div>

      <div class="text-center">
        <a href="/login" class="font-medium text-blue-600 hover:text-blue-500 text-sm">
          {gettext("Back to sign in")}
        </a>
      </div>
    </.form>
  </div>
</div>
