<div class="min-h-screen flex items-center justify-center bg-base-200 relative">
  <Layouts.auth_toolbar locale={@locale} />
  <div class="max-w-md w-full space-y-8">
    <div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-base-content">
        {gettext("Create your account")}
      </h2>
      <p class="mt-2 text-center text-sm text-base-content/70">
        {gettext("Or")}
        <a href="/login" class="font-medium text-blue-600 hover:text-blue-500">
          {gettext("sign in to your existing account")}
        </a>
      </p>
    </div>

    <p class="text-center text-sm text-base-content/70">
      {gettext("First, verify your email address. We'll send you a one-time code.")}
    </p>

    <.form
      for={@form}
      id="registration-email-form"
      action={~p"/register"}
      method="post"
      class="mt-6 space-y-6"
    >
      <div class="space-y-4">
        <.input
          field={@form[:email]}
          type="email"
          label={gettext("Email address")}
          placeholder={gettext("you@company.com")}
          required
          autocomplete="email"
        />
      </div>

      <div>
        <.button type="submit" class="group relative w-full justify-center py-2">
          {gettext("Send verification code")}
        </.button>
      </div>
    </.form>
  </div>
</div>
