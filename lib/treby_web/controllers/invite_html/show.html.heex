<div class="min-h-screen bg-base-200 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-base-content">
      {gettext("Join %{tenant_name}", tenant_name: @tenant.name)}
    </h2>
    <p class="mt-2 text-center text-sm text-base-content/70">
      {gettext("You've been invited to join as a team member")}
    </p>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-base-100 py-8 px-4 shadow sm:rounded-lg sm:px-10">
      <%= cond do %>
        <% @mismatch -> %>
          <div class="space-y-4 text-center">
            <p class="text-sm text-base-content/70">
              {gettext("You are logged in as %{current} but this invite is for %{existing}",
                current: @current_user.email,
                existing: @existing_user.email
              )}
            </p>
            <div class="flex gap-2 justify-center">
              <.button
                variant="primary"
                href={~p"/session"}
                method="delete"
                class="w-full justify-center"
              >
                {gettext("Log out and continue as %{email}", email: @existing_user.email)}
              </.button>
            </div>
            <p class="text-xs text-base-content/50">
              {gettext("Or log out and log in as the invited email")}
            </p>
          </div>
        <% @needs_login -> %>
          <div class="space-y-4 text-center">
            <p class="text-sm text-base-content/70">
              {gettext("Please log in as %{email} to accept this invite",
                email: @existing_user.email
              )}
            </p>
            <.button variant="primary" navigate={~p"/login"} class="w-full justify-center">
              {gettext("Log in")}
            </.button>
          </div>
        <% @needs_accept -> %>
          <.form
            for={%{}}
            id="invite-accept-existing-form"
            action={~p"/invite/#{@invite.token}"}
            method="post"
            class="space-y-6"
          >
            <div class="text-center">
              <p class="text-sm text-base-content/70">
                {gettext("You are logged in as %{email}", email: @existing_user.email)}
              </p>
              <p class="text-sm text-base-content/70">
                {gettext("Click below to join %{tenant}", tenant: @tenant.name)}
              </p>
            </div>
            <div>
              <.button variant="primary" type="submit" class="w-full justify-center">
                {gettext("Join %{tenant}", tenant: @tenant.name)}
              </.button>
            </div>
          </.form>
        <% true -> %>
          <.form
            for={%{}}
            id="invite-accept-form"
            action={~p"/invite/#{@invite.token}"}
            method="post"
            class="space-y-6"
          >
            <div>
              <label for="user_name" class="block text-sm font-medium text-base-content/80">
                {gettext("Full Name")}
              </label>
              <input
                id="user_name"
                name="user[name]"
                type="text"
                required
                class="mt-1 block w-full rounded-md border-base-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm"
              />
            </div>

            <div>
              <label for="user_email" class="block text-sm font-medium text-base-content/80">
                {gettext("Email")}
              </label>
              <input
                id="user_email"
                name="user[email]"
                type="email"
                value={@invite.email}
                disabled
                class="mt-1 block w-full rounded-md border-base-300 shadow-sm bg-base-200 sm:text-sm"
              />
            </div>

            <div>
              <label for="user_password" class="block text-sm font-medium text-base-content/80">
                {gettext("Password")}
              </label>
              <input
                id="user_password"
                name="user[password]"
                type="password"
                required
                class="mt-1 block w-full rounded-md border-base-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm"
              />
            </div>

            <div>
              <.button variant="primary" type="submit" class="w-full justify-center">
                {gettext("Accept Invite & Create Account")}
              </.button>
            </div>
          </.form>
      <% end %>
    </div>
  </div>
</div>
