<Layouts.app flash={@flash} current_scope={@current_user}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Email Queue</h1>
    </div>

    <div class="mb-6 border-b border-gray-200">
      <nav class="flex space-x-8" role="tablist">
        <button
          phx-click="switch_tab"
          phx-value-tab="queued"
          class={[
            "py-3 px-1 text-sm font-medium border-b-2 transition-colors",
            @tab == "queued" && "border-blue-500 text-blue-600",
            @tab != "queued" &&
              "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300"
          ]}
        >
          Queued ({@counts.queued})
        </button>
        <button
          phx-click="switch_tab"
          phx-value-tab="sent"
          class={[
            "py-3 px-1 text-sm font-medium border-b-2 transition-colors",
            @tab == "sent" && "border-blue-500 text-blue-600",
            @tab != "sent" &&
              "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300"
          ]}
        >
          Sent ({@counts.sent})
        </button>
        <button
          phx-click="switch_tab"
          phx-value-tab="failed"
          class={[
            "py-3 px-1 text-sm font-medium border-b-2 transition-colors",
            @tab == "failed" && "border-red-500 text-red-600",
            @tab != "failed" &&
              "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300"
          ]}
        >
          Failed ({@counts.failed})
        </button>
        <button
          phx-click="switch_tab"
          phx-value-tab="cancelled"
          class={[
            "py-3 px-1 text-sm font-medium border-b-2 transition-colors",
            @tab == "cancelled" && "border-gray-500 text-gray-600",
            @tab != "cancelled" &&
              "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300"
          ]}
        >
          Cancelled ({@counts.cancelled})
        </button>
      </nav>
    </div>

    <%= if @selected_ids != MapSet.new() do %>
      <div class="mb-4 flex items-center gap-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
        <span class="text-sm text-gray-600">{MapSet.size(@selected_ids)} selected</span>
        <%= if @tab == "queued" do %>
          <button
            phx-click="bulk_send_now"
            class="text-sm px-3 py-1.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
          >
            Send Selected
          </button>
          <button
            phx-click="bulk_cancel"
            class="text-sm px-3 py-1.5 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors"
          >
            Cancel Selected
          </button>
        <% end %>
        <button
          phx-click="deselect_all"
          class="text-sm px-3 py-1.5 text-gray-600 hover:text-gray-800 transition-colors"
        >
          Clear selection
        </button>
      </div>
    <% end %>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <%= if @emails == [] do %>
        <div class="text-center py-16 text-gray-500">
          <p class="text-lg font-medium">
            <%= case @tab do %>
              <% "queued" -> %>
                No queued emails
              <% "sent" -> %>
                No sent emails yet
              <% "failed" -> %>
                No failed emails
              <% "cancelled" -> %>
                No cancelled emails
            <% end %>
          </p>
          <p class="mt-1 text-sm">
            <%= case @tab do %>
              <% "queued" -> %>
                Emails you schedule will appear here
              <% "sent" -> %>
                Successfully sent emails will appear here
              <% "failed" -> %>
                Emails that failed to send will appear here
              <% "cancelled" -> %>
                Cancelled emails will appear here
            <% end %>
          </p>
        </div>
      <% else %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="w-10 px-3 py-3">
                <input
                  type="checkbox"
                  phx-click={
                    if Enum.count(@emails) == MapSet.size(@selected_ids),
                      do: "deselect_all",
                      else: "select_all"
                  }
                  checked={
                    Enum.count(@emails) > 0 && Enum.count(@emails) == MapSet.size(@selected_ids)
                  }
                  class="rounded border-gray-300 text-blue-600"
                />
              </th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                To
              </th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Subject
              </th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden md:table-cell">
                Type
              </th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden md:table-cell">
                <%= if @tab in ~w(queued cancelled) do %>
                  Scheduled
                <% else %>
                  Date
                <% end %>
              </th>
              <%= if @tab == "failed" do %>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden lg:table-cell">
                  Error
                </th>
              <% end %>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <%= for email <- @emails do %>
              <tr class={[
                "hover:bg-gray-50 transition-colors",
                email.status == "scheduled" && "bg-blue-50/30"
              ]}>
                <td class="w-10 px-3 py-4">
                  <%= if @tab == "queued" or @tab == "cancelled" do %>
                    <input
                      type="checkbox"
                      phx-click="toggle_select"
                      phx-value-id={email.id}
                      checked={MapSet.member?(@selected_ids, email.id)}
                      class="rounded border-gray-300 text-blue-600"
                    />
                  <% end %>
                </td>
                <td class="px-4 py-4 text-sm text-gray-900 max-w-[180px] truncate">
                  {email.to_address}
                </td>
                <td class="px-4 py-4 text-sm text-gray-700 max-w-[280px] truncate">
                  {email.subject}
                </td>
                <td class="px-4 py-4 text-sm text-gray-500 hidden md:table-cell">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700">
                    {email_type_label(email.email_type)}
                  </span>
                </td>
                <td class="px-4 py-4 text-sm text-gray-500 hidden md:table-cell whitespace-nowrap">
                  <%= cond do %>
                    <% email.status == "sent" -> %>
                      {format_datetime(email.sent_at)}
                    <% email.status == "failed" -> %>
                      {format_datetime(email.failed_at)}
                    <% true -> %>
                      {format_datetime(email.scheduled_at)}
                      <%= if email.jitter_minutes && email.jitter_minutes > 0 do %>
                        <span class="text-xs text-gray-400">±{email.jitter_minutes}m</span>
                      <% end %>
                  <% end %>
                </td>
                <%= if @tab == "failed" do %>
                  <td
                    class="px-4 py-4 text-sm text-red-600 hidden lg:table-cell max-w-[200px] truncate"
                    title={email.error_reason}
                  >
                    {email.error_reason}
                  </td>
                <% end %>
                <td class="px-4 py-4 text-sm text-right whitespace-nowrap">
                  <%= if @tab == "queued" do %>
                    <button
                      phx-click="open_edit"
                      phx-value-id={email.id}
                      class="text-blue-600 hover:text-blue-800 transition-colors mr-2"
                    >
                      Edit
                    </button>
                    <button
                      phx-click="send_now"
                      phx-value-id={email.id}
                      class="text-green-600 hover:text-green-800 transition-colors mr-2"
                    >
                      Send Now
                    </button>
                    <button
                      phx-click="cancel"
                      phx-value-id={email.id}
                      class="text-red-600 hover:text-red-800 transition-colors"
                    >
                      Cancel
                    </button>
                  <% end %>
                  <%= if @tab == "failed" do %>
                    <button
                      phx-click="retry"
                      phx-value-id={email.id}
                      class="text-blue-600 hover:text-blue-800 transition-colors mr-2"
                    >
                      Retry
                    </button>
                    <button
                      phx-click="delete"
                      phx-value-id={email.id}
                      class="text-red-600 hover:text-red-800 transition-colors"
                    >
                      Delete
                    </button>
                  <% end %>
                  <%= if @tab == "cancelled" do %>
                    <button
                      phx-click="send_now"
                      phx-value-id={email.id}
                      class="text-green-600 hover:text-green-800 transition-colors mr-2"
                    >
                      Send Now
                    </button>
                    <button
                      phx-click="delete"
                      phx-value-id={email.id}
                      class="text-red-600 hover:text-red-800 transition-colors"
                    >
                      Delete
                    </button>
                  <% end %>
                  <%= if @tab == "sent" do %>
                    <span class="text-gray-400">-</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>

  <%= if @edit_email do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50">
      <div class="bg-white rounded-xl shadow-xl max-w-lg w-full mx-4 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Edit Scheduled Email</h2>

        <.form
          for={@edit_form}
          id="edit-scheduled-email"
          phx-submit="save_edit"
          as={:scheduled_email}
        >
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">To</label>
              <input
                type="text"
                value={@edit_email.to_address}
                disabled
                class="w-full px-3 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-500 text-sm"
              />
              <p class="text-xs text-gray-400 mt-1">Recipient cannot be changed</p>
            </div>
            <div>
              <label
                for="scheduled_email_subject"
                class="block text-sm font-medium text-gray-700 mb-1"
              >
                Subject
              </label>
              <input
                id="scheduled_email_subject"
                type="text"
                name="scheduled_email[subject]"
                value={@edit_form[:subject].value}
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm"
              />
            </div>
            <div>
              <label
                for="scheduled_email_body"
                class="block text-sm font-medium text-gray-700 mb-1"
              >
                Body
              </label>
              <textarea
                id="scheduled_email_body"
                name="scheduled_email[body]"
                rows="5"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm"
              ><%= @edit_form[:body].value %></textarea>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label
                  for="scheduled_email_scheduled_at_date"
                  class="block text-sm font-medium text-gray-700 mb-1"
                >
                  Date
                </label>
                <input
                  id="scheduled_email_scheduled_at_date"
                  type="date"
                  name="scheduled_email[scheduled_at_date]"
                  value={@edit_form[:scheduled_at_date].value}
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm"
                />
              </div>
              <div>
                <label
                  for="scheduled_email_scheduled_at_time"
                  class="block text-sm font-medium text-gray-700 mb-1"
                >
                  Time
                </label>
                <input
                  id="scheduled_email_scheduled_at_time"
                  type="time"
                  name="scheduled_email[scheduled_at_time]"
                  value={@edit_form[:scheduled_at_time].value}
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm"
                />
              </div>
            </div>
            <div>
              <label
                for="scheduled_email_jitter_minutes"
                class="block text-sm font-medium text-gray-700 mb-1"
              >
                Jitter (± minutes)
              </label>
              <input
                id="scheduled_email_jitter_minutes"
                type="number"
                name="scheduled_email[jitter_minutes]"
                value={@edit_form[:jitter_minutes].value}
                min="0"
                max="30"
                class="w-24 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm"
              />
              <p class="text-xs text-gray-400 mt-1">
                Adds randomness so emails don't all arrive at the exact same time
              </p>
            </div>
          </div>

          <div class="mt-6 flex justify-end gap-3">
            <button
              type="button"
              phx-click="close_edit"
              class="px-4 py-2 text-sm text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="px-4 py-2 text-sm text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition-colors"
            >
              Save
            </button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>
</Layouts.app>
