<div class="min-h-screen bg-base-200 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-base-content">
      {gettext("Join %{tenant_name}", tenant_name: @tenant.name)}
    </h2>
    <p class="mt-2 text-center text-sm text-base-content/70">
      {gettext("You've been invited to join as a team member")}
    </p>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-base-100 py-8 px-4 shadow sm:rounded-lg sm:px-10">
      <.form
        for={%{}}
        id="invite-accept-form"
        action={~p"/invite/#{@invite.token}"}
        method="post"
        class="space-y-6"
      >
        <div>
          <label for="user_name" class="block text-sm font-medium text-base-content/80">
            {gettext("Full Name")}
          </label>
          <input
            id="user_name"
            name="user[name]"
            type="text"
            required
            class="mt-1 block w-full rounded-md border-base-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
          />
        </div>

        <div>
          <label for="user_email" class="block text-sm font-medium text-base-content/80">
            {gettext("Email")}
          </label>
          <input
            id="user_email"
            name="user[email]"
            type="email"
            value={@invite.email}
            disabled
            class="mt-1 block w-full rounded-md border-base-300 shadow-sm bg-base-200 sm:text-sm"
          />
        </div>

        <div>
          <label for="user_password" class="block text-sm font-medium text-base-content/80">
            {gettext("Password")}
          </label>
          <input
            id="user_password"
            name="user[password]"
            type="password"
            required
            class="mt-1 block w-full rounded-md border-base-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
          />
        </div>

        <div>
          <button
            type="submit"
            class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-base-200 focus:ring-blue-500"
          >
            {gettext("Accept Invite & Create Account")}
          </button>
        </div>
      </.form>
    </div>
  </div>
</div>
