<div class="min-h-screen flex items-center justify-center bg-zinc-50 dark:bg-zinc-800 relative">
  <.link navigate={~p"/"} class="absolute top-4 left-4 z-50 flex items-center">
    <span class="text-xl font-bold text-primary dark:text-orange-300">Treby</span>
  </.link>
  <Layouts.auth_toolbar locale={@locale} />
  <div class="max-w-md w-full space-y-8">
    <div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-zinc-900 dark:text-zinc-100">
        {gettext("Create your account")}
      </h2>
      <p class="mt-2 text-center text-sm text-zinc-500 dark:text-zinc-400">
        {gettext("Or")}
        <a
          href="/login"
          class="font-medium text-primary dark:text-orange-300 hover:text-primary/80 dark:hover:text-orange-200"
        >
          {gettext("sign in to your existing account")}
        </a>
      </p>
    </div>

    <p class="text-center text-sm text-zinc-500 dark:text-zinc-400">
      {gettext("First, verify your email address. We'll send you a one-time code.")}
    </p>

    <.form
      for={@form}
      id="registration-email-form"
      action={~p"/register"}
      method="post"
      class="mt-6 space-y-6"
    >
      <div class="space-y-4">
        <.input
          field={@form[:email]}
          type="email"
          label={gettext("Email address")}
          placeholder={gettext("you@company.com")}
          required
          autocomplete="email"
        />
      </div>

      <div>
        <.button
          variant="primary"
          type="submit"
          class="w-full justify-center"
          phx-disable-with={gettext("Sending...")}
        >
          {gettext("Send verification code")}
        </.button>
      </div>
    </.form>
  </div>
</div>
