# Treby environment variables
#
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
#
# The application reads these from the environment. How you inject them
# (shell exports, a process manager, etc.) is up to you.
#
# Variables marked [prod] are required only in production.
# Everything else has a sensible dev default and is optional.

# --- Core / Endpoint ---
# [prod] Required. Generate with: mix phx.gen.secret
SECRET_KEY_BASE=
# [prod] Public host of the app, e.g. treby.example.com
PHX_HOST=localhost
# Port the web server listens on (default: 4000)
PORT=4000
# Set to "true" to start the server in a release (production)
PHX_SERVER=
# Set to "true" to use IPv6 for the database connection
ECTO_IPV6=
# Database connection pool size (default: 10)
POOL_SIZE=10
# [prod] Required. Ecto URL, e.g. ecto://USER:PASS@HOST/DATABASE
DATABASE_URL=
# DNS cluster query for multi-node deployments
DNS_CLUSTER_QUERY=

# --- Encryption (Cloak) ---
# 32-byte base64-encoded key. Has dev default; override in prod.
CLOAK_KEY=

# --- File storage (S3 / RustFS) ---
# Dev defaults point at the local RustFS instance from docker-compose.
S3_SCHEME=http://
S3_HOST=localhost
S3_PORT=9000
S3_ACCESS_KEY_ID=treby
S3_SECRET_ACCESS_KEY=treby_password

# --- Email (Swoosh) ---
# Only needed when configuring a production mail adapter (e.g. Mailgun).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# --- Background jobs (Oban) ---
# Table prefix for Oban in production (usually "public")
OBAN_PREFIX=

# --- Google Calendar integration ---
# Used for interview scheduling (connect Google Calendar in Settings).
# Create OAuth credentials at https://console.cloud.google.com/
# Redirect URI: http://localhost:4000/auth/google/callback  (dev)
#               https://YOUR_DOMAIN/auth/google/callback    (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
