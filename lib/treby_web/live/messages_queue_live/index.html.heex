<Layouts.app
  flash={@flash}
  current_scope={@current_user}
  current_tenant={@current_tenant}
  current_membership={@current_membership}
  available_tenants={@available_tenants}
  notification_unread_count={assigns[:notification_unread_count] || 0}
  notification_recent={assigns[:notification_recent] || []}
>
  <div class="p-8">
    <TrebyWeb.SettingsLayout.settings_shell
      current_tenant={@current_tenant}
      current_membership={@current_membership}
      active_key={:messages_queue}
    >
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center justify-between mb-6">
          <h1 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100">Message Queue</h1>
        </div>

        <div class="mb-6 border-b border-zinc-200 dark:border-zinc-700">
          <nav class="flex space-x-8" role="tablist">
            <button
              phx-click="switch_tab"
              phx-value-tab="scheduled"
              class={[
                "py-3 px-1 text-sm font-medium border-b-2 transition-colors",
                @tab == "scheduled" &&
                  "border-primary text-primary dark:text-orange-300 dark:border-orange-300",
                @tab != "scheduled" &&
                  "border-transparent text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:border-zinc-200 dark:hover:border-zinc-700"
              ]}
            >
              Scheduled ({@counts.scheduled})
            </button>
            <button
              phx-click="switch_tab"
              phx-value-tab="sent"
              class={[
                "py-3 px-1 text-sm font-medium border-b-2 transition-colors",
                @tab == "sent" &&
                  "border-primary text-primary dark:text-orange-300 dark:border-orange-300",
                @tab != "sent" &&
                  "border-transparent text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:border-zinc-200 dark:hover:border-zinc-700"
              ]}
            >
              Posted ({@counts.sent})
            </button>
            <button
              phx-click="switch_tab"
              phx-value-tab="failed"
              class={[
                "py-3 px-1 text-sm font-medium border-b-2 transition-colors",
                @tab == "failed" &&
                  "border-red-600 text-red-600 dark:text-red-400 dark:border-red-400",
                @tab != "failed" &&
                  "border-transparent text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:border-zinc-200 dark:hover:border-zinc-700"
              ]}
            >
              Failed ({@counts.failed})
            </button>
            <button
              phx-click="switch_tab"
              phx-value-tab="cancelled"
              class={[
                "py-3 px-1 text-sm font-medium border-b-2 transition-colors",
                @tab == "cancelled" &&
                  "border-zinc-500 text-zinc-900 dark:text-zinc-100 dark:border-zinc-500",
                @tab != "cancelled" &&
                  "border-transparent text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:border-zinc-200 dark:hover:border-zinc-700"
              ]}
            >
              Cancelled ({@counts.cancelled})
            </button>
          </nav>
        </div>

        <%= if @selected_ids != MapSet.new() do %>
          <div class="mb-4 flex items-center gap-3 p-3 bg-zinc-50 dark:bg-zinc-800 rounded-lg border border-zinc-200 dark:border-zinc-700">
            <span class="text-sm text-zinc-500 dark:text-zinc-400">{MapSet.size(@selected_ids)} selected</span>
            <%= if @tab == "scheduled" do %>
              <.button phx-click="bulk_send_now" variant="primary" size="sm">
                Post Selected
              </.button>
              <.button phx-click="bulk_cancel" variant="danger" size="sm">
                Cancel Selected
              </.button>
            <% end %>
            <button
              phx-click="deselect_all"
              class="text-sm px-3 py-1.5 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:text-zinc-100/90 transition-colors"
            >
              Clear selection
            </button>
          </div>
        <% end %>

        <div class="bg-white dark:bg-zinc-800 rounded-xl shadow-sm border border-zinc-200 dark:border-zinc-700 overflow-hidden">
          <%= if @messages == [] do %>
            <div class="text-center py-16 text-zinc-500 dark:text-zinc-400">
              <p class="text-lg font-medium">
                <%= case @tab do %>
                  <% "scheduled" -> %>
                    No scheduled messages
                  <% "sent" -> %>
                    No posted messages yet
                  <% "failed" -> %>
                    No failed messages
                  <% "cancelled" -> %>
                    No cancelled messages
                <% end %>
              </p>
              <p class="mt-1 text-sm">
                <%= case @tab do %>
                  <% "scheduled" -> %>
                    Messages you schedule will appear here
                  <% "sent" -> %>
                    Successfully posted messages will appear here
                  <% "failed" -> %>
                    Messages that failed to post will appear here
                  <% "cancelled" -> %>
                    Cancelled messages will appear here
                <% end %>
              </p>
            </div>
          <% else %>
            <div class="mb-2 flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
              <input
                type="checkbox"
                id="messages-select-all"
                phx-click={
                  if Enum.count(@messages) == MapSet.size(@selected_ids),
                    do: "deselect_all",
                    else: "select_all"
                }
                checked={
                  Enum.count(@messages) > 0 &&
                    Enum.count(@messages) == MapSet.size(@selected_ids)
                }
                class="rounded border-zinc-300 dark:border-zinc-600 text-orange-600 focus:ring-orange-500 h-4 w-4 bg-white dark:bg-zinc-800"
              />
              <label for="messages-select-all">Select all</label>
            </div>
            <.table id="messages" rows={@messages} row_id={fn m -> "message-#{m.id}" end}>
              <:col :let={message} label="">
                <%= if @tab == "scheduled" or @tab == "cancelled" do %>
                  <input
                    type="checkbox"
                    phx-click="toggle_select"
                    phx-value-id={message.id}
                    checked={MapSet.member?(@selected_ids, message.id)}
                    class="rounded border-zinc-300 dark:border-zinc-600 text-orange-600 focus:ring-orange-500 h-4 w-4 bg-white dark:bg-zinc-800"
                  />
                <% end %>
              </:col>
              <:col :let={message} label="Body">
                <span class="text-sm text-zinc-900 dark:text-zinc-100/80 max-w-[320px] truncate block">
                  {message.body}
                </span>
              </:col>
              <:col :let={message} label="Type">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-zinc-50 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100/80">
                  {message_type_label(message.message_type)}
                </span>
              </:col>
              <:col :let={message} label={if @tab in ~w(scheduled cancelled), do: "Scheduled", else: "Date"}>
                <span class="text-sm text-zinc-500 dark:text-zinc-400 whitespace-nowrap">
                  <%= cond do %>
                    <% message.status == "sent" -> %>
                      {format_datetime(message.sent_at)}
                    <% message.status == "failed" -> %>
                      {format_datetime(message.failed_at)}
                    <% true -> %>
                      {format_datetime(message.send_at)}
                  <% end %>
                </span>
              </:col>
              <:col :let={message} :if={@tab == "failed"} label="Error">
                <span
                  class="text-sm text-red-600 max-w-[200px] truncate block"
                  title={message.error_reason}
                >
                  {message.error_reason}
                </span>
              </:col>
              <:action :let={message}>
                <%= if @tab == "scheduled" do %>
                  <button
                    phx-click="open_edit"
                    phx-value-id={message.id}
                    class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors mr-2"
                  >
                    Edit
                  </button>
                  <button
                    phx-click="send_now"
                    phx-value-id={message.id}
                    class="text-green-600 dark:text-green-400 hover:text-green-800 dark:hover:text-green-300 transition-colors mr-2"
                  >
                    Post Now
                  </button>
                  <button
                    phx-click="cancel"
                    phx-value-id={message.id}
                    class="text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 transition-colors"
                  >
                    Cancel
                  </button>
                <% end %>
                <%= if @tab == "failed" do %>
                  <button
                    phx-click="retry"
                    phx-value-id={message.id}
                    class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors mr-2"
                  >
                    Retry
                  </button>
                  <button
                    phx-click="delete"
                    phx-value-id={message.id}
                    class="text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 transition-colors"
                  >
                    Delete
                  </button>
                <% end %>
                <%= if @tab == "cancelled" do %>
                  <button
                    phx-click="send_now"
                    phx-value-id={message.id}
                    class="text-green-600 dark:text-green-400 hover:text-green-800 dark:hover:text-green-300 transition-colors mr-2"
                  >
                    Post Now
                  </button>
                  <button
                    phx-click="delete"
                    phx-value-id={message.id}
                    class="text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 transition-colors"
                  >
                    Delete
                  </button>
                <% end %>
                <%= if @tab == "sent" do %>
                  <span class="text-zinc-500 dark:text-zinc-400">-</span>
                <% end %>
              </:action>
            </.table>
          <% end %>
        </div>
      </div>
    </TrebyWeb.SettingsLayout.settings_shell>
  </div>

  <.modal
    :if={@edit_message != nil}
    id="edit-scheduled-message-modal"
    show={true}
    title="Edit Scheduled Message"
    size="lg"
    close_event="close_edit"
  >
    <.form
      for={@edit_form}
      id="edit-scheduled-message"
      phx-submit="save_edit"
      as={:scheduled_message}
    >
      <div class="space-y-4">
        <div>
          <label
            for="scheduled_message_body"
            class="block text-sm font-medium text-zinc-900 dark:text-zinc-100/80 mb-1"
          >
            Body
          </label>
          <textarea
            id="scheduled_message_body"
            name="scheduled_message[body]"
            rows="5"
            class="w-full rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-3 py-2 text-sm text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
          ><%= @edit_form[:body].value %></textarea>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label
              for="scheduled_message_scheduled_at_date"
              class="block text-sm font-medium text-zinc-900 dark:text-zinc-100/80 mb-1"
            >
              Date
            </label>
            <input
              id="scheduled_message_scheduled_at_date"
              type="date"
              name="scheduled_message[scheduled_at_date]"
              value={@edit_form[:scheduled_at_date].value}
              class="w-full rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-3 py-2 text-sm text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
            />
          </div>
          <div>
            <label
              for="scheduled_message_scheduled_at_time"
              class="block text-sm font-medium text-zinc-900 dark:text-zinc-100/80 mb-1"
            >
              Time
            </label>
            <input
              id="scheduled_message_scheduled_at_time"
              type="time"
              name="scheduled_message[scheduled_at_time]"
              value={@edit_form[:scheduled_at_time].value}
              class="w-full rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-3 py-2 text-sm text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
            />
          </div>
        </div>
      </div>

      <div class="mt-6 flex justify-end gap-3">
        <.button type="button" phx-click="close_edit" variant="ghost">
          Cancel
        </.button>
        <.button type="submit" variant="primary" loading_text={gettext("Saving...")}>
          Save
        </.button>
      </div>
    </.form>
  </.modal>
</Layouts.app>
