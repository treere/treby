<div class="min-h-screen flex items-center justify-center bg-base-200 relative">
  <Layouts.auth_toolbar locale={@locale} />
  <div class="max-w-md w-full space-y-8">
    <div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-base-content">
        {gettext("Check your email")}
      </h2>
      <p class="mt-2 text-center text-sm text-base-content/70">
        {gettext("We sent a 6-digit code to")}
        <span class="font-medium text-base-content">{@email}</span>
      </p>
      <p class="mt-1 text-center text-xs text-base-content/50">
        {gettext("Check your email (including spam)")}
      </p>
    </div>

    <.form
      for={@form}
      id="verify-code-form"
      action={~p"/register/verify"}
      method="post"
      class="mt-6 space-y-6"
    >
      <div class="space-y-4">
        <.input
          field={@form[:code]}
          type="text"
          label={gettext("Verification code")}
          placeholder="123456"
          inputmode="numeric"
          autocomplete="one-time-code"
          maxlength="6"
          required
        />
      </div>

      <div>
        <.button type="submit" class="group relative w-full justify-center py-2">
          {gettext("Verify email")}
        </.button>
      </div>
    </.form>

    <div class="text-center space-y-2">
      <.form
        for={@resend_form}
        id="resend-code-form"
        action={~p"/register"}
        method="post"
      >
        <.input type="hidden" field={@resend_form[:email]} />
        <button
          type="submit"
          id="resend-code-btn"
          phx-hook=".ResendCountdown"
          data-countdown="60"
          class="text-sm font-medium text-blue-600 hover:text-blue-500 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          {gettext("Didn't receive it? Resend code")}
        </button>
      </.form>
      <script :type={Phoenix.LiveView.ColocatedHook} name=".ResendCountdown">
        export default {
          mounted() {
            const btn = this.el
            let remaining = parseInt(btn.dataset.countdown || "60", 10)
            btn.disabled = true
            const original = btn.textContent.trim()
            const tick = () => {
              if (remaining <= 0) {
                btn.disabled = false
                btn.textContent = original
                clearInterval(timer)
              } else {
                btn.textContent = `Resend in ${remaining}s`
                remaining -= 1
              }
            }
            tick()
            const timer = setInterval(tick, 1000)
            this._timer = timer
          },
          destroyed() {
            if (this._timer) clearInterval(this._timer)
          }
        }
      </script>
      <div>
        <a href="/register" class="text-sm text-base-content/70 hover:text-base-content">
          {gettext("Use a different email")}
        </a>
      </div>
    </div>
  </div>
</div>
